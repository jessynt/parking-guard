# 停车场坐标（WGS-84）
PARK_LAT=31.230416
PARK_LON=121.473701
PARK_PLACE=停车场

# Bark
BARK_KEY=你的BarkKey
BARK_SERVER=https://api.day.app
BARK_GROUP=停车场
BARK_SOUND=alarm
BARK_LEVEL=timeSensitive

# MQTT broker 地址：同 compose 服务名、宿主机 IP、局域网 IP 或域名都可以。
# 注意：容器里的 127.0.0.1 指容器自己，不能用它访问宿主机上的 broker。
MQTT_HOST=192.168.1.100
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0
MQTT_TLS_INSECURE=0
MQTT_PREFIX=teslamate/cars
CAR_ID=1

# 围栏和停车优惠
PARK_RADIUS_ENTER=80
PARK_RADIUS_EXIT=150
PARK_CONFIRM_SECONDS=90
PARK_REQUIRE_P=1
PARK_ACCEPT_UNKNOWN_SHIFT=1
DISCOUNT_MINUTES=180
WARN_MINUTES=30,10,5
EXIT_BUFFER_MINUTES=10
MAX_SESSION_HOURS=14

# 运行
TICK_SECONDS=15
STATUS_LOG_SECONDS=300
# 本地运行用 ./data；Docker 会覆盖为 /data/parking_state.json
STATE_FILE=./data/parking_state.json
# 排查时改为 DEBUG：输出每条 MQTT 报文、距离判定、状态机和 Bark 细节
LOG_LEVEL=INFO
TZ=Asia/Shanghai
